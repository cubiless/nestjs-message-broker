{
  "name": "@cubiles/nestjs-message-broker",
  "description": "The idea behind this module is to connect it to a message broker that enables the permanent distribution of messages.",
  "private": false,
  "version": "11.4.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cubiless/nestjs-message-broker"
  },
  "keywords": [
    "nestjs",
    "rabbitmq",
    "event",
    "queue",
    "message-broker"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rimraf -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start:dev": "nest start -p tsconfig.json --watch",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "lint": "eslint \"lib/**/*.ts\" --fix",
    "format": "prettier --write \"lib/**/*.ts\"",
    "release": "release-it"
  },
  "dependencies": {
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "cloudevents": "^10.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.16",
    "@nestjs/common": "11.1.15",
    "@nestjs/core": "11.1.15",
    "@nestjs/platform-express": "11.1.15",
    "@nestjs/testing": "11.1.15",
    "@types/amqplib": "^0.10.8",
    "@types/jest": "30.0.0",
    "@types/node": "25.3.3",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "reflect-metadata": "0.2.2",
    "release-it": "^19.2.4",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  }
}
